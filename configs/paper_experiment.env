# Agent models
NATURAL_MODEL=openai/gpt-5.4-nano
FALSE_REASON_MODEL=openai/gpt-5.4-nano
RETRY_MODEL=openai/gpt-5.4-nano
LEAN_MODEL=gpt-5.4
ORCHESTRATOR_MODEL=gpt-5.4

# Pass@1 evaluation budget
MAX_ROUNDS=3
MAX_TRIALS=3
MODEL_TIMEOUT_SETS_01_03=0
MODEL_TIMEOUT_SETS_04_05=900
VERIFY_TIMEOUT=300

# The published 35/38 and 0/24 results used this legacy prompt layout.
DUAL_MEMORY_SCHEMA=paper_merged
